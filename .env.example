# ============================================================================
# ICARE Core Banking System - Environment Configuration Template
# ============================================================================
# IMPORTANT:
# 1. Never commit real credentials, service-role keys, or JWT secrets to Git.
# 2. In LOCAL DEVELOPMENT, set SUPABASE_URL to your local or staging Supabase
#    instance (e.g. http://127.0.0.1:54321). Do NOT point local dev to production.
# 3. Streamlit secrets (.streamlit/secrets.toml) are DEPRECATED and ignored.
# ============================================================================

# Environment Indicator: 'development', 'staging', 'production', or 'test'
ENVIRONMENT=development

# Database Endpoint (Required in all environments)
# Local: http://127.0.0.1:54321
# Staging/Prod: https://<project-id>.supabase.co
SUPABASE_URL=https://your-project-id.supabase.co

# Backend Database Credentials:
# - SUPABASE_SERVICE_ROLE_KEY is MANDATORY in production (fails closed if missing or 'anon').
# - SUPABASE_KEY (anon key) is permitted ONLY in development/testing.
SUPABASE_SERVICE_ROLE_KEY=your_service_role_key_here
SUPABASE_KEY=your_anon_key_here

# Authoritative Session Secret (Minimum 32 characters, used for HMAC JWT signing)
ICARE_AUTH_SECRET=change_this_to_a_secure_random_string_at_least_32_characters_long

# CORS Allowed Origins (Comma-separated)
ALLOWED_ORIGINS=https://icare-banking.vercel.app,https://icare-core.onrender.com,http://localhost:3000,http://localhost:8080,http://127.0.0.1:8080,http://localhost:5000,http://127.0.0.1:5000,http://localhost:8000,http://127.0.0.1:8000,http://10.0.2.2:8000

# Optional APM & Observability (Sentry)
# SENTRY_DSN=https://examplePublicKey@o0.ingest.sentry.io/0
# SENTRY_TRACES_SAMPLE_RATE=0.2
# SENTRY_PROFILES_SAMPLE_RATE=0.1
