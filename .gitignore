# ==============================================================================
# ICARE CORE BANKING - BULLETPROOF .GITIGNORE SPECIFICATION
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. Environment & Secret Credentials (Strict Zero-Leakage)
# ------------------------------------------------------------------------------
.env
.env.*
*.env
!.env.example
!*.env.example
*.key
*.pem
*.secret
*.p12
*.pfx
*.keystore
*.jks
secrets.toml
*/secrets.toml
.streamlit/secrets.toml
secrets.json
*/secrets.json
service_role_key*
*service_role*
credentials.json
*service-account*.json
id_rsa*
id_ed25519*

# ------------------------------------------------------------------------------
